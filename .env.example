# Live generation. Without it the app still runs: the four example chips load
# pre-built fixtures, and the LLM routes answer 503 behind an offline banner.
OPENROUTER_API_KEY=

# The model behind every call. See "Choosing a model" in the README.
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# Comma-separated OpenRouter provider slugs, most preferred first. Pinning
# sends allow_fallbacks:false — a fallback lands back on the broken route.
OPENROUTER_PROVIDER_ORDER=fireworks

# An effort level, a number (reasoning token budget), or `off`.
OPENROUTER_REASONING=low

# A whole graph is a large tool-call payload; a verbose model needs more room.
OPENROUTER_MAX_OUTPUT_TOKENS=32000
